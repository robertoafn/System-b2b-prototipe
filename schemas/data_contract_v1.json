      "primary_key": ["delivery_line_id"],
      "columns": [
        {"name": "delivery_line_id", "type": "string", "nullable": false, "pattern": "^DLN-SYN-[0-9]{7}$"},
        {"name": "delivery_id", "type": "string", "nullable": false},
        {"name": "order_line_id", "type": "string", "nullable": false},
        {"name": "delivered_quantity", "type": "number", "nullable": false},
        {"name": "scenario_id", "type": "string", "nullable": false},
        {"name": "dataset_build_id", "type": "string", "nullable": false, "pattern": "^BLD-[A-F0-9]{20}$"},
        {"name": "is_synthetic", "type": "boolean", "nullable": false}
      ]
