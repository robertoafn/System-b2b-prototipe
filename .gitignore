# Local editor and historical working material
/.obsidian/
/.snapshots/

# Python caches and local test artifacts
**/__pycache__/
*.py[cod]
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/

# Power BI temporary lock files
/powerbi/~$*
/powerbi/source/export/**/.pbi/

# Publish only the approved, sanitized contracts and manual chat instructions
/docs/*
!/docs/PROJECT-CONTROL.md
!/docs/MVP-SPEC.md
!/docs/DATA-CONTRACT.md
!/docs/KPI-POWERBI-SPEC.md
!/docs/chats_instruction/
!/docs/chats_instruction/**
